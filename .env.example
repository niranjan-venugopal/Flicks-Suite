# ============================================================
# Flicks Suite — Environment Variables
# Copy to .env.local and fill in real values
# ============================================================

# ----- Database (Supabase) -----
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Service role — BYPASSRLS — FAM only, never expose to frontend
DATABASE_SERVICE_ROLE_URL=postgresql://postgres.[project-ref]:[service-role-password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ----- Auth / JWT -----
# Generate a strong 256-bit+ key: `openssl rand -base64 48` (min 32 chars enforced;
# in production a key under 48 chars logs a startup warning).
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
# TOTP for FAM (admin.flickssuite.com only)
TOTP_SECRET=your-totp-issuer-secret
# Cookie settings
COOKIE_DOMAIN=.flickssuite.com
COOKIE_SECURE=true

# ----- Email (Resend) -----
RESEND_API_KEY=re_...
EMAIL_FROM_AUTH=auth@flickssuite.com
EMAIL_FROM_NOTIFICATIONS=notifications@flickssuite.com
EMAIL_REPLY_TO=support@flickssuite.com

# ----- File Storage (Cloudflare R2) -----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=flicks-suite-files
R2_PUBLIC_URL=https://files.flickssuite.com

# ----- Cache / Queues (Upstash Redis) -----
REDIS_URL=rediss://...@...upstash.io:6379
REDIS_TOKEN=...

# ----- Monitoring -----
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=...
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ----- App URLs -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# FAM admin panel (separate Next.js app or subdomain route)
FAM_ADMIN_URL=http://localhost:3001

# ----- NestJS API -----
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- Rate Limiting -----
THROTTLE_TTL=3600000
THROTTLE_LIMIT=100

# ----- IFSC Lookup (Razorpay public API, no auth needed) -----
IFSC_API_URL=https://ifsc.razorpay.com

# ----- Encryption (for PAN, bank, passport) -----
# 32-byte hex key for pgcrypto pgp_sym_encrypt
DB_ENCRYPTION_KEY=your-32-byte-encryption-key-hex

# ----- Invoice PDF (headless Chromium) -----
# PDFs are produced by rendering the hosted invoice page (/inv/:token) with
# Puppeteer, so the API host MUST be able to run Chromium. `pnpm install`
# downloads a matching Chromium automatically; on slim/serverless hosts either
# keep that download or point at a system Chromium:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# The renderer fetches PUBLIC_INVOICE_BASE_URL/inv/:token, so that URL must be
# reachable from the API (defaults to http://localhost:3000 in dev).
# PUBLIC_INVOICE_BASE_URL=https://app.flickssuite.com
