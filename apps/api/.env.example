# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/flicks_suite
DATABASE_SERVICE_ROLE_URL=postgres://postgres:password@localhost:5432/flicks_suite

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=flicks-suite
JWT_AUDIENCE=flicks-suite-api

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@flicks.app
EMAIL_FROM_NAME=Flicks Suite

# ─── App URLs ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
MAGIC_LINK_BASE_URL=http://localhost:3000/auth/magic

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=flicks-suite-uploads
R2_PUBLIC_URL=https://pub.r2.dev

# ─── Security ────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
MAGIC_LINK_EXPIRY_MINUTES=30
MAX_OTP_ATTEMPTS=5
MAX_OTP_PER_HOUR=5
TRUSTED_DEVICE_EXPIRY_DAYS=30
