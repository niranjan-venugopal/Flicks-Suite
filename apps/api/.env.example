# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL is the app connection — uses the flicks_app role, which is
# NOSUPERUSER + NOBYPASSRLS so that Row-Level Security is actually enforced.
# (Run `pnpm setup:db` to create this role and apply the schema.)
DATABASE_URL=postgres://flicks_app:flicks_app@127.0.0.1:5432/flicks_suite

# DATABASE_SERVICE_ROLE_URL is the admin connection — uses the postgres
# superuser. The FAM module and a few platform-level lookups (e.g. discovering
# a user's memberships at login, before any tenant context exists) use this.
DATABASE_SERVICE_ROLE_URL=postgres://postgres:postgres@127.0.0.1:5432/flicks_suite

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong secret with: openssl rand -hex 48
JWT_SECRET=replace-with-a-strong-random-secret-at-least-48-bytes-of-hex
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=flicks-suite
JWT_AUDIENCE=flicks-suite-api

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get a key at https://resend.com/api-keys
# In dev with the free tier, EMAIL_FROM must be onboarding@resend.dev and
# emails will only deliver to the address you signed up with.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Flicks Suite

# ─── App URLs ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
MAGIC_LINK_BASE_URL=http://localhost:3000/verify
# Base for PUBLIC customer-facing links: hosted invoices (/inv/<token>) and
# mandate authorization pages (/sub/<token>). ⚠ Falls back to localhost when
# blank — MUST be the real web domain in production or emailed links break.
PUBLIC_INVOICE_BASE_URL=http://localhost:3000

# ─── Object storage (Cloudflare R2 OR any S3-compatible backend) ─────────────
# Used by avatar/logo uploads and data exports (PRD v4 §4/§3.5). LEAVE BLANK
# when you have no storage — those features then show a clean "storage not
# configured" message and everything else works. Do NOT use placeholder
# values: a non-empty ACCOUNT_ID makes the app think storage is live.
#
# Option A — Supabase Storage (no new account; S3-compatible):
#   1. Supabase Dashboard → Storage → New bucket "flicks-suite-uploads" (private)
#   2. Storage → Settings → "S3 Connection" → enable + create access key
#   3. Set R2_ENDPOINT to the shown endpoint, e.g.
#      R2_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#      R2_REGION=<project region, e.g. ap-south-1>
#      R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY = the S3 access key pair
#      (R2_ACCOUNT_ID stays blank — not needed with a custom endpoint)
#
# Option B — Cloudflare R2 (free tier; requires a card on file):
#   R2_ACCOUNT_ID=<cloudflare account id> + API token keys; leave R2_ENDPOINT blank.
#
# Option C — local MinIO (docker run -p 9000:9000 minio/minio server /data):
#   R2_ENDPOINT=http://127.0.0.1:9000  R2_ACCESS_KEY_ID=minioadmin  R2_SECRET_ACCESS_KEY=minioadmin
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=flicks-suite-uploads
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_REGION=auto

# ─── Security ────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
MAGIC_LINK_EXPIRY_MINUTES=30
MAX_OTP_ATTEMPTS=5
MAX_OTP_PER_HOUR=5
TRUSTED_DEVICE_EXPIRY_DAYS=30
# Key used to encrypt FAM TOTP secrets at rest (openssl rand -hex 32).
# Leave blank in dev — FAM TOTP enforcement no-ops without it.
TOTP_SECRET=

# ─── Razorpay live payments (OAuth Connect, Sprint 15) ───────────────────────
# Partner-app credentials from the Razorpay partner dashboard. Sellers connect
# their own Razorpay account via OAuth; orders are created on the sub-merchant
# with a Bearer access token. Leave blank in dev — connect/order endpoints
# return a clear 503/400 until the partner app is provisioned.
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI registered with Razorpay. Defaults to
# ${API_URL}/api/v1/invoicing/razorpay/callback when blank.
RAZORPAY_OAUTH_REDIRECT_URI=
# Partner-level webhook secret (set in the Razorpay partner dashboard webhook).
# The webhook verifies the HMAC over the raw body against this.
RAZORPAY_WEBHOOK_SECRET=
# Legacy direct key pair (v3 mandate-link stub + fallbacks). Optional; the
# OAuth sub-merchant flow above is the real tenant-track integration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# AES-256-GCM key to encrypt per-tenant Razorpay OAuth tokens at rest
# (openssl rand -hex 32). Leave blank in dev — tokens stored as plaintext.
INVOICING_SECRET_ENC_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
# Server-side Sentry DSN. Leave blank in local dev — the SDK no-ops without it.
SENTRY_DSN=
# Server-side PostHog (posthog-node). Captures funnel/security-critical events
# (tenant signup, impersonation). Leave blank in local dev — captures no-op.
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# ─── Backups (scripts/backup-*.sh, scripts/restore-drill.sh) ─────────────────
# Direct (session-mode, port 5432) connection used by pg_dump. Distinct from
# DATABASE_URL, which is the pooled app connection.
DATABASE_DIRECT_URL=
# Weekly off-site snapshots land in this R2 bucket (S3-compatible API).
R2_BACKUP_BUCKET=flicks-suite-backups
# Restore-drill target — MUST point at staging, never production.
STAGING_DATABASE_DIRECT_URL=

# ─── Platform billing (PRD v4 §8B — Specflicks' OWN Razorpay merchant) ────────
# Sandbox keys first (rzp_test_…). Blank in dev: subscribe/coupon endpoints
# return a clear 503; the 7-day trial + paywall still work (date-driven).
RAZORPAY_PLATFORM_KEY_ID=
RAZORPAY_PLATFORM_KEY_SECRET=
# Webhook secret for POST /webhooks/razorpay-platform (set in the Razorpay
# dashboard webhook config; distinct from the tenant-track webhook secret).
RAZORPAY_PLATFORM_WEBHOOK_SECRET=
