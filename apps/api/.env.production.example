# =============================================================================
# Flicks Suite API — PRODUCTION env template (Railway)
# =============================================================================
# Paste these into Railway → your API service → Variables, filling in the
# real values. `<domain>` = your apex domain (app lives at app.<domain>,
# API at api.<domain>, inbound mail at in.<domain>).
#
# Ordered by consequence:
#   §1 required to BOOT       — the app exits on startup without these
#   §2 required for CORRECTNESS — boots without them, but a feature breaks
#   §3 deferred / parked      — leave blank until you turn the feature on
#
# Full walkthrough: docs/go-live-runbook.md
# =============================================================================

# ─── §1 Required to boot ─────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000

# Pooled app connection (Supabase transaction pooler, port 6543) using the
# ⚠ flicks_app role — NOT postgres. RLS only isolates tenants under a
# NOBYPASSRLS role. Password = the APP_ROLE_PASSWORD you set when running
# `pnpm sync:supabase` (URL-encode special chars: @ → %40).
DATABASE_URL=postgres://flicks_app:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Admin connection (session pooler, port 5432) as postgres — FAM + platform
# lookups that legitimately bypass RLS.
DATABASE_SERVICE_ROLE_URL=postgres://postgres:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Fresh secret, ≥48 bytes: openssl rand -base64 48
# (Rotating this later invalidates consent hashes, calendar-ICS and CRM-form
# tokens — fine before launch, disruptive after.)
JWT_SECRET=

# Exact web origins, comma-separated, NO wildcards — the app fail-fasts on a
# wildcard in production. HTTP CORS and WebSocket CORS both read this.
CORS_ORIGINS=https://app.<domain>

# Joi-REQUIRED — the app refuses to boot without a Resend key.
RESEND_API_KEY=

# Railway Redis plugin reference. ⚠ Keep ?family=0 — Railway's private
# network is IPv6-only and ioredis needs the hint or you get ENOTFOUND.
REDIS_URL=${{Redis.REDIS_URL}}?family=0

# ─── §2 Required for correctness ─────────────────────────────────────────────

APP_URL=https://app.<domain>
API_URL=https://api.<domain>

# Full URL INCLUDING the /verify path — magic-link + invite emails append
# ?token=… to exactly this string.
MAGIC_LINK_BASE_URL=https://app.<domain>/verify

# Base for PUBLIC customer links: hosted invoices (/inv/<token>) and mandate
# pages (/sub/<token>). Falls back to localhost when blank → emailed links
# would break.
PUBLIC_INVOICE_BASE_URL=https://app.<domain>

# Sending identity — must be on the domain you verified in Resend (SPF+DKIM).
EMAIL_FROM=noreply@mail.<domain>
EMAIL_FROM_NAME=Flicks Suite

# Resend → Webhooks → endpoint https://api.<domain>/api/v1/webhooks/resend →
# copy its signing secret here. ⚠ Unset in production = EVERY Resend webhook
# (bounces, complaints, inbound BCC email) is rejected with 401.
RESEND_WEBHOOK_SECRET=

# Inbound (BCC-dropbox) domain — verified as a receiving domain in Resend
# with its MX record + catch-all enabled.
INBOUND_EMAIL_DOMAIN=in.<domain>

# Object storage (R2 or any S3-compatible). Real values or BLANK — never
# placeholders (a non-empty account id makes the app think storage is live).
# Blank = uploads/exports/hosted-invoice assets return a clean 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=flicks-suite-uploads
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_REGION=auto

# At-rest encryption keys — one `openssl rand -hex 32` EACH (not shared).
# ⚠ Blank = the corresponding secrets are stored in PLAINTEXT.
INVOICING_SECRET_ENC_KEY=
WEBHOOK_SECRET_ENC_KEY=
EMAIL_TOKEN_KEY=

# FAM TOTP at-rest key: openssl rand -hex 32. ⚠ Blank = TOTP enrolment
# silently no-ops and platform-admin logins skip the second factor. Set this
# BEFORE your first FAM login.
TOTP_SECRET=

# Live FX for multi-currency invoicing/deals (openexchangerates.org — free
# tier is fine). Blank = static fallback rates.
OPENEXCHANGERATES_APP_ID=

# Observability (recommended from day 1).
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# Direct (session, 5432) connection for scripts/backups — used from YOUR
# machine (promote-platform-admin.sh, seed-coupons.sh, pg_dump), not by the
# server, but harmless to set here for reference.
DATABASE_DIRECT_URL=

# Set automatically by the Dockerfile (distro Chromium for invoice PDFs) —
# do NOT override on Railway.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Swagger stays OFF in production unless you explicitly set SWAGGER_ENABLED=1.
# SWAGGER_ENABLED=

# ─── §3 Deferred / parked (your launch decisions) ────────────────────────────

# Platform billing (Razorpay) — DEFERRED: dogfood free first. Blank = the
# subscribe endpoints 503 cleanly; the 7-day trial stays date-driven, which
# is why you redeem FOUNDER-001 in Phase 5 of the runbook.
RAZORPAY_PLATFORM_KEY_ID=
RAZORPAY_PLATFORM_KEY_SECRET=
RAZORPAY_PLATFORM_WEBHOOK_SECRET=
# Tenant-track (sellers collecting payments) — same posture.
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
RAZORPAY_OAUTH_REDIRECT_URI=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# GitHub integration — PARKED (Coming soon; per-user OAuth planned).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# ⚠ SINGLE-INSTANCE DEPLOY (the supported topology): set NEITHER of these —
# the API process then runs the outbox dispatcher + queue consumers inline.
# Setting WORKER_MODE=true or INLINE_WORKER=false WITHOUT a second worker
# service = no events ever dispatch (watch for "OUTBOX STALLED" in logs).
# WORKER_MODE=
# INLINE_WORKER=
