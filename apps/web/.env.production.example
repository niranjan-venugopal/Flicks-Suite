# =============================================================================
# Flicks Suite web — PRODUCTION env template (Vercel)
# =============================================================================
# Paste into Vercel → Project → Settings → Environment Variables (Production).
#
# ⚠ NEXT_PUBLIC_* values are BAKED INTO THE BUNDLE AT BUILD TIME. Changing
# any of them later requires a redeploy, not just a variable edit.
# =============================================================================

# The API origin — Railway service behind your custom domain.
NEXT_PUBLIC_API_URL=https://api.<domain>

# The canonical PUBLIC origin of this app. Used for SEO absolute URLs:
# metadataBase (OpenGraph/canonical tags), /robots.txt and /sitemap.xml.
# Defaults to https://app.flickssuite.com when unset.
NEXT_PUBLIC_APP_URL=https://app.<domain>

# Client-side Sentry (optional but recommended). Blank = SDK no-ops.
NEXT_PUBLIC_SENTRY_DSN=

# Client-side PostHog (optional). Blank = captures no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Build-time Sentry source-map upload (optional — nicer stack traces).
# These are BUILD secrets, not runtime: safe to set only for the build step.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
