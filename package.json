{
  "name": "flicks-suite",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "pnpm --filter @flicks/api test",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @flicks/db generate",
    "db:migrate": "pnpm --filter @flicks/db migrate",
    "db:seed": "pnpm --filter @flicks/db seed",
    "db:seed:invoice": "pnpm --filter @flicks/db seed:invoice",
    "db:studio": "pnpm --filter @flicks/db studio",
    "setup:db": "bash scripts/setup-db.sh",
    "setup:database": "bash scripts/setup-database.sh",
    "sync:supabase": "bash scripts/sync-supabase.sh",
    "uninstall:invoicing": "psql \"$DATABASE_DIRECT_URL\" -v ON_ERROR_STOP=1 -f scripts/uninstall-invoicing.sql",
    "setup:demo": "bash scripts/setup-demo.sh",
    "setup": "pnpm install && pnpm setup:db && pnpm db:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.10",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11"
  }
}
